<h1>Мои задачи</h1>
<%@tasks.each do |task|%>
  <li><%= task.title %>
    <% if task.done %>
      [X] <%= button_to 'Удалить задачу', "/tasks/#{task.id}/delete" %>
    <% else %>
      [ ] <%= button_to 'Выполнить', "/tasks/#{task.id}/complete"%> <%= button_to 'Удалить задачу', "/tasks/#{task.id}/delete" %>
    <%end%></li>
<%end%>
