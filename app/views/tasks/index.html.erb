<h1>Мои задачи</h1>
<ul>
  <% @tasks.each do |task| %>
    <li>
      <% if task.done %>
        [X] <%= task.title %> <%= button_to 'Удалить задачу', "/tasks/#{task.id}", method: :delete %> <%= link_to 'Изменить', "/tasks/#{task.id}/edit" %>
      <% else %>
        [ ] <%= task.title %> <%= button_to 'Выполнить', "/tasks/#{task.id}/complete"%> <%= button_to 'Удалить задачу', "/tasks/#{task.id}", method: :delete %> <%= link_to 'Изменить', "/tasks/#{task.id}/edit" %>
      <% end %>
    </li>
  <% end %>
</ul>
